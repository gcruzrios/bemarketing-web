# Solo permitir el endpoint público; bloquear todo lo demás en esta carpeta
# (config con credenciales, librería PHPMailer, etc.)
<FilesMatch "^(?!send-mail\.php$).*$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
