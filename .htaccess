# =========================================================
# BeMarketing — URLs amigables (sin extensión .html)
#   /index.html          → /
#   /social-media.html   → /social-media
#   /social-media        → sirve social-media.html internamente
# Requiere Apache con mod_rewrite habilitado.
# =========================================================

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1) /index.html (o /carpeta/index.html) → / con redirección 301
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L,NE]

# 2) /pagina.html → /pagina con redirección 301
#    THE_REQUEST evita bucles: solo aplica a lo que pidió el navegador,
#    no a las reescrituras internas de la regla 4.
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 3) Quitar la barra final en páginas (/social-media/ → /social-media)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 4) /pagina → sirve pagina.html sin cambiar la URL visible
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
